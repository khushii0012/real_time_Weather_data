# ==========================================
# Real-Time Weather Data Pipeline Configuration
# ==========================================

# --- Weather API Settings (Open-Meteo) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Default coordinates: London (can be configured for any city, e.g. Delhi: 28.6139, 77.2090)
WEATHER_LATITUDE=51.5074
WEATHER_LONGITUDE=-0.1278
WEATHER_CITY=London
POLL_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=10

# --- Apache Kafka Settings ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NAME=weather-data
KAFKA_CLIENT_ID=weather-producer-client

# --- PostgreSQL Database Settings ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weather_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_TABLE=weather_readings

# --- Spark Structured Streaming Settings ---
SPARK_APP_NAME=WeatherRealTimeStreamProcessor
SPARK_CHECKPOINT_DIR=./checkpoints/weather_stream
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1
POSTGRES_JDBC_PACKAGE=org.postgresql:postgresql:42.7.3
